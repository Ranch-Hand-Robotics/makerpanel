{
  "name": "makerpanel-website",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "catalog": "python -c \"import runpy; runpy.run_path('.github/hooks.py')['sync_examples_into_gallery_json']()\"",
    "thumbnails:setup": "node scripts/thumbnails/setup.mjs",
    "thumbnails": "npm run catalog && node scripts/thumbnails/generate.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:metadata",
    "test:metadata": "python -m unittest discover -s tests -p test_gallery_metadata.py",
    "build": "npm run thumbnails && python -m mkdocs build --strict"
  },
  "devDependencies": {
    "adm-zip": "0.6.1",
    "playwright": "1.58.2",
    "sharp": "0.35.4",
    "three": "0.183.2"
  }
}